# Copy this file to .env before running anything:
#   cp .env.example .env
#
# The defaults below work as-is for local development, both with
# docker compose and with the utils/*.sh scripts (docker-compose.yml
# overrides DATABASE_URL/REDIS_URL/API_URL to use container hostnames —
# see docker-compose.yml for those values).

# --- Backend ---
ENV=local
DATABASE_URL=postgresql+asyncpg://cimi:cimi@localhost:5432/cimi
REDIS_URL=redis://localhost:6379/0
# Desktop frontend runs on :3000, mobile frontend on :3001 — both need CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Frontend (desktop and mobile both read these) ---
# Server-side fetches (Server Components) — reach the backend directly.
API_URL=http://localhost:8000
# Client-side (browser) fetches — must be reachable from the user's machine.
NEXT_PUBLIC_API_URL=http://localhost:8000
